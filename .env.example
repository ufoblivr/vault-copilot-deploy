# API authentication (recommended for public deployments)
VAULT_API_KEY=

# Database and persistent storage
VAULT_DB_PATH=finance.db
VAULT_CHROMA_PATH=chroma_db
VAULT_UPLOAD_DIR=raw_receipts

# AI models
VAULT_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
VAULT_EMBEDDING_MODEL=all-MiniLM-L6-v2
VAULT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Agent and RAG
VAULT_MAX_AGENT_STEPS=3
VAULT_LLM_MAX_TOKENS=150
VAULT_LLM_TEMPERATURE=0.1
VAULT_RAG_TOP_K=5
VAULT_RELEVANCE_THRESHOLD=0.3

# Security and limits
VAULT_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
VAULT_MAX_UPLOAD_SIZE_MB=10
VAULT_SQL_TIMEOUT_MS=5000
VAULT_SQL_MAX_ROWS=1000

# UI
VAULT_API_URL=http://localhost:8000/api
VAULT_LOG_JSON=false
VAULT_LOG_LEVEL=INFO
